{
  "manifest_version": 3,
  "name": "Pagenova",
  "version": "0.1.9",
  "description": "Browser-native AI assistant with chat, page context and local/cloud providers.",
  "permissions": ["sidePanel", "storage", "activeTab", "tabs", "scripting", "contextMenus", "offscreen"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Pagenova"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
